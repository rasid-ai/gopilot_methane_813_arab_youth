# GoPilot credentials. Copy this file to creds.env (which git ignores) and fill it in to fly the missions live.
# Left as placeholders, the notebook replays the recorded missions in results/ instead, so "Run all" still works.
#
# They belong to an IAM user that can only call the GoPilot runtime (bedrock-agentcore:InvokeAgentRuntime),
# and RASID can revoke it at any time.
AWS_ACCESS_KEY_ID=<PASTE_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<PASTE_SECRET_ACCESS_KEY>
GOPILOT_AGENT_ARN=<PASTE_RUNTIME_ARN>
GOPILOT_REGION=eu-central-1
